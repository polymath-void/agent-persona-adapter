   "score": 13.21,
   "tools": [],
   "capabilities": [],
   "section": "multiple_choice_questions",
   "src": "ref-repo/Cluely/Default Prompt.txt:38",
   "id": "d017"
  },
  {
   "text": "Provide mainly the response if there is an email/message/ANYTHING else to respond to / text to generate, in a code block.",
