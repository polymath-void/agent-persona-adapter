   "src": "ref-repo/Cluely/Default Prompt.txt:48",
   "id": "d020"
  },
  {
   "text": "Provide EXTREMELY detailed step-by-step instructions with granular specificity.",
   "category": "workflow",
   "strength": 1,
   "score": 13.88,
   "tools": [],
   "capabilities": [],
   "section": "ui_navigation",
