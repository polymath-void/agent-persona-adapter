   "tools": [],
   "capabilities": [],
   "section": "behavioral_directive",
   "src": "ref-repo/Cluely/Enterprise Prompt.txt:269",
   "id": "d070"
  },
  {
   "text": "If you have user context, use it to create a detailed example.",
