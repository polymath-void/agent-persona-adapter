   "strength": 2,
   "score": 22.75,
   "tools": [],
   "capabilities": [],
   "section": "ui_navigation",
   "src": "ref-repo/Cluely/Default Prompt.txt:60",
   "id": "d022"
  },
  {
   "text": "Be comprehensive enough that someone unfamiliar could follow exactly.",
